# Stable base64-encoded 32-byte random key. Never commit the real value.
PBM_ENCRYPTION_KEY=
PBM_BASE_DOMAIN=formics.online
PBM_MANAGER_HOST=pb.formics.online
PBM_AGENT_SOCKET=/run/pbmanager-agent/agent.sock
PBM_DATA_DIR=./pb_data
PBM_FRONTEND_DIR=../frontend/dist
# Use false for local HTTP development only.
PBM_SECURE_COOKIES=false
PBM_POCKETBASE_VERSION=0.39.0
PBM_POCKETBASE_BINARY=/opt/pbmanager/bin/pocketbase
